---
// Card — conteneur de contenu (programmes, annonces, blocs). Bordure haute
// dorée optionnelle (accentTop) pour marquer une carte mise en avant.
interface Props {
  accentTop?: boolean;
  elevated?: boolean;
  padded?: boolean;
  class?: string;
}
const { accentTop = false, elevated = true, padded = true, class: className } = Astro.props;
---
<div
  class:list={[
    'card',
    { 'card--accent-top': accentTop, 'card--flat': !elevated, 'card--bare': !padded },
    className,
  ]}
>
  <slot />
</div>

<style>
  .card {
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    box-shadow: var(--shadow-md);
    padding: var(--space-6);
    font-family: var(--font-sans);
  }
  .card--accent-top { border-top: 4px solid var(--brand-accent); }
  .card--flat { box-shadow: none; }
  .card--bare { padding: 0; }
</style>
