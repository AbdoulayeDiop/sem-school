---
// Accordion — FAQ dépliable. Utilise <details>/<summary> natif : aucun JS.
import Icon from './Icon.astro';
interface Props {
  items: readonly { question: string; answer: string }[];
}
const { items } = Astro.props;
---
<div class="accordion">
  {items.map((item) => (
    <details class="accordion__item">
      <summary class="accordion__summary">
        <span>{item.question}</span>
        <span class="accordion__chevron"><Icon name="chevron-down" size={20} /></span>
      </summary>
      <div class="accordion__answer">{item.answer}</div>
    </details>
  ))}
</div>

<style>
  .accordion { display: flex; flex-direction: column; gap: 10px; }
  .accordion__item {
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-card);
  }
  .accordion__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding: 14px 18px;
    cursor: pointer;
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--text-heading);
    list-style: none;
  }
  .accordion__summary::-webkit-details-marker { display: none; }
  .accordion__chevron {
    color: var(--brand-accent);
    display: inline-flex;
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  .accordion__item[open] .accordion__chevron { transform: rotate(180deg); }
  .accordion__answer {
    padding: 0 18px 16px;
    font-size: var(--text-body-sm);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
  }
</style>
