---
// ImageSlot — affiche une vraie photo si `src` est fourni, sinon un
// placeholder labellisé (le README du design system interdit d'inventer des
// images ; les emplacements sans photo restent des placeholders clairs).
import Icon from './Icon.astro';
interface Props {
  label: string;
  src?: string;
  radius?: number;
  class?: string;
}
const { label, src, radius = 16, class: className } = Astro.props;
---
{src ? (
  <img
    src={src}
    alt={label}
    loading="lazy"
    decoding="async"
    class:list={['imgslot-img', className]}
    style={`border-radius:${radius}px`}
  />
) : (
  <div class:list={['imgslot', className]} style={`border-radius:${radius}px`} role="img" aria-label={`Photo à venir : ${label}`}>
    <Icon name="image" size={26} />
    <span class="imgslot__label">{label}</span>
  </div>
)}

<style>
  .imgslot-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .imgslot {
    width: 100%;
    height: 100%;
    min-height: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-4);
    background: linear-gradient(135deg, var(--gray-100), var(--gold-100));
    border: 1px dashed var(--border-strong);
    color: var(--text-muted);
  }
  .imgslot__label {
    font-size: var(--text-caption);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
  }
</style>
