---
// Accueil — reproduction du design 1B « Éditorial chaleureux » (Claude Design).
// Site une seule page : hero photo, atouts, parcours des niveaux, galerie,
// calendrier, tarifs en cartes, contact + carte.
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { site, atouts, tarifs, directionWord } from '../data/site';

const stats = [
  { num: '2026', label: 'Année de création' },
  { num: 'Mat.→Tle', label: 'Tous les niveaux' },
  { num: 'Bilingue', label: 'Dès la classe de CI' },
];

const parcours = [
  { n: 1, name: 'Préscolaire', age: '3 – 5 ans', classes: 'Petite · Moyenne · Grande section' },
  { n: 2, name: 'Élémentaire', age: '6 – 11 ans', classes: 'CI · CP · CE1 · CE2 · CM1 · CM2' },
  { n: 3, name: 'Collège', age: '12 – 15 ans', classes: '6ème · 5ème · 4ème · 3ème' },
  { n: 4, name: 'Lycée', age: '16 – 18 ans', classes: 'Seconde · Première · Terminale (S & L)', last: true },
];

const galerie = [
  { src: '/galerie/classe-1.webp', label: 'Une salle de classe' },
  { src: '/galerie/exterieur.webp', label: "L'entrée de l'école" },
  { src: '/galerie/escalier.webp', label: 'Les escaliers' },
  { src: '/galerie/classe-2.webp', label: 'Salle de classe' },
  { src: '/galerie/classe-3.webp', label: 'Salle de classe' },
];
---
<Base
  title="Accueil"
  description="SEM School — école privée à Malika, Dakar, du préscolaire à la terminale. Effectifs réduits, 100% de réussite aux examens. Inscriptions 2026-2027."
>
  <!-- Hero -->
  <section class="hero wrap">
    <div class="hero__text">
      <Badge variant="gold">Rentrée {site.schoolYear}</Badge>
      <h1 class="hero__title serif">Apprendre.<br />Grandir.<br /><span class="hero__accent">Réussir.</span></h1>
      <p class="hero__lead">
        École privée à Malika, Dakar, du préscolaire à la terminale. Un cadre bienveillant à
        effectifs réduits, tourné vers 100% de réussite aux examens.
      </p>
      <div class="hero__actions">
        <Button href="/#contact" variant="accent" size="lg">S'inscrire maintenant</Button>
        <Button href="/#ecole" variant="secondary" size="lg">Découvrir l'école</Button>
      </div>
      <div class="hero__stats">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat__num serif">{s.num}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="hero__media">
      <div class="hero__photo"><ImageSlot label="Façade de l'école SEM School — Malika, Dakar" src="/galerie/facade.webp" radius={20} /></div>
      <div class="hero__devise">
        <div class="hero__devise-label">Notre devise</div>
        <div class="hero__devise-text serif">{site.tagline}</div>
      </div>
    </div>
  </section>

  <!-- Atouts (Notre école) -->
  <section id="ecole" class="atouts">
    <div class="atouts__grid wrap">
      {atouts.map((a) => (
        <div class="atout">
          <div class="atout__icon"><Icon name={a.icon} size={28} /></div>
          <h3 class="atout__title">{a.title}</h3>
          <p class="atout__text">{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Mot du fondateur -->
  <section class="fondateur wrap">
    <div class="fondateur__grid">
      <div class="fondateur__text">
        <p class="overline">Mot du fondateur</p>
        <div class="fondateur__quote serif">
          {directionWord.paragraphs.map((p, i) => (
            <p>{i === 0 ? '« ' : ''}{p}{i === directionWord.paragraphs.length - 1 ? ' »' : ''}</p>
          ))}
        </div>
        <div class="fondateur__sign">
          <div class="fondateur__name">{directionWord.name}</div>
          <div class="fondateur__role">{directionWord.role}</div>
        </div>
      </div>
      <div class="fondateur__media">
        <div class="fondateur__badge"><Icon name="quote" size={30} /></div>
        <div class="fondateur__photo"><ImageSlot label="Portrait du fondateur / directeur" src="/galerie/fondateur.webp" radius={20} /></div>
      </div>
    </div>
  </section>

  <!-- Niveaux parcours -->
  <section id="niveaux" class="parcours wrap">
    <div class="sec-head">
      <p class="overline">Un parcours complet</p>
      <h2 class="sec-title serif">Du préscolaire à la terminale</h2>
    </div>
    <div class="parcours__grid">
      <div class="parcours__line" aria-hidden="true"></div>
      {parcours.map((p) => (
        <div class="step">
          <div class:list={['step__num serif', { 'step__num--last': p.last }]}>{p.n}</div>
          <h3 class="step__name">{p.name}</h3>
          <div class="step__age">{p.age}</div>
          <div class="step__classes">{p.classes}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Galerie -->
  <section class="galerie wrap">
    <div class="sec-head">
      <p class="overline">La vie à l'école</p>
      <h2 class="sec-title serif">En images</h2>
    </div>
    <div class="galerie__grid">
      {galerie.map((photo, i) => (
        <div class:list={['galerie__cell', { 'galerie__cell--big': i === 0 }]}>
          <ImageSlot label={photo.label} src={photo.src} />
        </div>
      ))}
    </div>
  </section>

  <!-- Calendrier timeline -->
  <section class="calendrier">
    <div class="calendrier__inner">
      <div class="sec-head">
        <p class="overline">Dates clés</p>
        <h2 class="sec-title serif">Calendrier des inscriptions</h2>
      </div>
      <div class="timeline">
        <div class="tl-item">
          <div class="tl-date"><span class="tl-day serif">10</span><span class="tl-month">AOÛT</span></div>
          <span class="tl-dot"></span>
          <p class="tl-text">Ouverture des inscriptions pour le <strong>préscolaire</strong> et démarrage des cours de vacances.</p>
        </div>
        <div class="tl-item">
          <div class="tl-date"><span class="tl-day serif">03</span><span class="tl-month">SEPT.</span></div>
          <span class="tl-dot"></span>
          <p class="tl-text">Inscriptions pour le <strong>CI, la 6ème</strong> et les classes de seconde (séries S et L).</p>
        </div>
        <div class="tl-item tl-item--last">
          <div class="tl-date"><span class="tl-day serif">10</span><span class="tl-month">SEPT.</span></div>
          <span class="tl-dot"></span>
          <p class="tl-text"><strong>Test obligatoire</strong> pour les classes de CP, CE1, CE2 et 5ème.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tarifs -->
  <section id="tarifs" class="tarifs wrap">
    <div class="sec-head sec-head--tight">
      <p class="overline">Frais de scolarité</p>
      <h2 class="sec-title serif">Nos tarifs</h2>
    </div>
    <div class="tarifs__grid">
      {tarifs.rows.map((r) => (
        <div class:list={['tcard', { 'tcard--featured': r.featured }]}>
          <div class="tcard__head">
            <div class="tcard__name serif">{r.name}</div>
            <div class="tcard__sub">{r.sub}</div>
          </div>
          <div class="tcard__body">
            <div class="tcard__k">Inscription</div>
            <div class="tcard__ins serif">{r.inscription} <span>{tarifs.currency}</span></div>
            <div class="tcard__k">Mensualité</div>
            <div class="tcard__mens serif">{r.mensualite} <span>{tarifs.currency}</span></div>
            <div class="tcard__extras">
              <div class="tcard__row"><span>2 uniformes</span><span>{r.uniformes} {tarifs.currency}</span></div>
              {r.sport && <div class="tcard__row"><span>Tenue de sport <em>(optionnel)</em></span><span>{r.sport} {tarifs.currency}</span></div>}
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="tarifs__foot">
      <ul class="tarifs__options">
        {tarifs.options.map((o) => (
          <li><strong>{o.label}</strong> — {o.value} <span class="tarifs__tag">optionnel</span></li>
        ))}
      </ul>
      {tarifs.notes.map((n) => <p class="tarifs__rule">{n}</p>)}
    </div>
  </section>

  <!-- Contact + localisation -->
  <section id="contact" class="contact">
    <div class="contact__grid">
      <div class="contact__map">
        <iframe
          title="Carte de localisation — SEM School, Malika, Dakar"
          src="https://www.openstreetmap.org/export/embed.html?bbox=-17.360%2C14.770%2C-17.310%2C14.810&layer=mapnik&marker=14.7906%2C-17.3350"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <div class="contact__info">
        <p class="overline overline--gold">Nous rejoindre</p>
        <h2 class="sec-title sec-title--light serif">Contact &amp; localisation</h2>
        <div class="cline">
          <Icon name="pin" size={20} />
          <span>{site.contact.address}</span>
        </div>
        <a class="cline" href={site.contact.phoneHref}>
          <Icon name="phone" size={20} />
          <span>{site.contact.phone}</span>
        </a>
        <a class="cline" href={site.contact.emailHref}>
          <Icon name="mail" size={20} />
          <span>{site.contact.email}</span>
        </a>
        <div class="contact__cta">
          <Button href={site.contact.phoneHref} variant="accent" size="lg">Demander une inscription</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .wrap { max-width: 1200px; margin-inline: auto; padding-inline: 44px; }

  .sec-head { text-align: center; margin-bottom: 44px; }
  .sec-head--tight { margin-bottom: 36px; }
  .sec-head .overline { margin: 0 0 8px; }
  .sec-title { font-size: 34px; color: var(--text-heading); margin: 0; }
  .sec-title--light { color: var(--text-inverse); }
  .overline--gold { color: var(--gold-400); }

  /* ---- Hero ---- */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    padding-block: 56px 64px;
  }
  .hero__title { font-weight: var(--weight-black); font-size: 56px; line-height: 1.08; color: var(--text-heading); margin: 20px 0 18px; }
  .hero__accent { color: var(--gold-600); }
  .hero__lead { font-size: 17px; color: var(--text-body); line-height: 1.65; max-width: 440px; margin: 0 0 28px; }
  .hero__actions { display: flex; gap: 14px; margin-bottom: 32px; flex-wrap: wrap; }
  .hero__stats { display: flex; gap: 36px; flex-wrap: wrap; }
  .stat__num { font-size: 30px; font-weight: var(--weight-black); color: var(--brand-primary); }
  .stat__label { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

  .hero__media { position: relative; }
  .hero__photo { height: 440px; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(13, 26, 51, 0.2); }
  .hero__devise {
    position: absolute; bottom: -18px; left: -18px;
    background: var(--brand-accent); color: var(--navy-900);
    border-radius: 14px; padding: 16px 20px; box-shadow: 0 10px 30px rgba(13, 26, 51, 0.25);
  }
  .hero__devise-label { font-size: 11px; font-weight: var(--weight-bold); letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.7; }
  .hero__devise-text { font-size: 19px; font-weight: var(--weight-black); margin-top: 2px; }

  /* ---- Atouts (bande navy) ---- */
  .atouts { background: var(--brand-primary); color: var(--text-inverse); padding-block: 52px; }
  .atouts__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .atout { text-align: center; }
  .atout__icon {
    width: 60px; height: 60px; border-radius: var(--radius-circle);
    background: var(--brand-accent); color: var(--navy-900);
    display: flex; align-items: center; justify-content: center; margin: 0 auto 14px;
  }
  .atout__title { margin: 0 0 6px; font-size: 16px; color: var(--text-inverse); }
  .atout__text { margin: 0; font-size: 13px; opacity: 0.8; line-height: 1.5; }

  /* ---- Mot du fondateur ---- */
  .fondateur { padding-block: 72px; }
  .fondateur__grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: center; }
  .fondateur__text .overline { margin: 0 0 20px; }
  .fondateur__quote { color: var(--text-heading); font-size: 20px; line-height: 1.7; }
  .fondateur__quote p { margin: 0 0 18px; }
  .fondateur__quote p:last-child { margin-bottom: 0; }
  .fondateur__sign { margin-top: 28px; }
  .fondateur__name { font-weight: var(--weight-bold); font-size: 18px; color: var(--text-heading); }
  .fondateur__role { font-size: 14px; color: var(--text-muted); margin-top: 2px; }

  .fondateur__media { position: relative; }
  .fondateur__photo { height: 420px; border-radius: 20px; overflow: hidden; }
  .fondateur__photo :global(img) { object-position: top; }
  .fondateur__badge {
    position: absolute; top: -22px; right: -22px; z-index: 2;
    width: 76px; height: 76px; border-radius: var(--radius-circle);
    background: var(--brand-accent); color: var(--navy-900);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 22px rgba(13, 26, 51, 0.2);
  }

  /* ---- Parcours ---- */
  .parcours { padding-block: 64px; }
  .parcours__grid { display: grid; grid-template-columns: repeat(4, 1fr); position: relative; }
  .parcours__line { position: absolute; top: 26px; left: 12%; right: 12%; height: 2px; background: var(--border-strong); }
  .step { text-align: center; position: relative; padding: 0 10px; }
  .step__num {
    width: 54px; height: 54px; border-radius: var(--radius-circle);
    background: var(--gold-100); border: 2px solid var(--brand-accent); color: var(--text-accent);
    display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;
    font-weight: var(--weight-black); position: relative; z-index: 1;
  }
  .step__num--last { background: var(--brand-accent); color: var(--navy-900); }
  .step__name { margin: 0 0 4px; font-size: 17px; color: var(--text-heading); }
  .step__age { font-size: 11px; color: var(--text-muted); margin-bottom: 8px; }
  .step__classes { font-size: 13px; color: var(--text-body); line-height: 1.7; }

  /* ---- Galerie ---- */
  .galerie { padding-block: 0 64px; }
  .galerie__grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 150px; gap: 14px; }
  .galerie__cell { position: relative; }
  .galerie__cell--big { grid-column: span 2; grid-row: span 2; }

  /* ---- Calendrier ---- */
  .calendrier { background: var(--surface-accent-soft); padding-block: 64px; }
  .calendrier__inner { max-width: 900px; margin-inline: auto; padding-inline: 44px; }
  .timeline { display: flex; flex-direction: column; }
  .tl-item {
    display: flex; gap: 24px; align-items: flex-start;
    border-left: 2px solid var(--brand-accent);
    margin-left: 80px; padding-left: 28px; padding-bottom: 28px; position: relative;
  }
  .tl-item--last { border-left-color: transparent; padding-bottom: 0; }
  .tl-date { position: absolute; left: -88px; top: 0; width: 72px; text-align: right; }
  .tl-day { display: block; font-size: 22px; font-weight: var(--weight-black); color: var(--brand-primary); line-height: 1; }
  .tl-month { display: block; font-size: 11px; color: var(--text-accent); font-weight: var(--weight-semibold); }
  .tl-dot { position: absolute; left: -9px; top: 2px; width: 14px; height: 14px; border-radius: var(--radius-circle); background: var(--brand-accent); border: 2px solid var(--surface-warm); }
  .tl-text { font-size: 15px; color: var(--text-body); line-height: 1.55; margin: 0; }
  .tl-text strong { color: var(--text-heading); }

  /* ---- Tarifs ---- */
  .tarifs { padding-block: 64px; }
  .tarifs__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .tcard { background: var(--surface-card); border: 1px solid var(--border-default); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow-sm); }
  .tcard__head { padding: 20px 22px; border-bottom: 1px solid var(--border-default); }
  .tcard__name { font-size: 19px; font-weight: var(--weight-bold); color: var(--text-heading); }
  .tcard__sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
  .tcard__body { padding: 22px; }
  .tcard__k { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .tcard__ins { font-size: 26px; font-weight: var(--weight-black); color: var(--brand-primary); margin: 2px 0 14px; }
  .tcard__mens { font-size: 26px; font-weight: var(--weight-black); color: var(--text-accent); margin-top: 2px; }
  .tcard__ins span, .tcard__mens span { font-size: 13px; font-weight: var(--weight-semibold); color: var(--text-muted); }
  /* Carte lycée mise en avant (navy) */
  .tcard--featured { background: var(--brand-primary); border-color: var(--brand-primary); box-shadow: var(--shadow-md); }
  .tcard--featured .tcard__head { border-bottom-color: rgba(255, 255, 255, 0.12); }
  .tcard--featured .tcard__name { color: var(--text-inverse); }
  .tcard--featured .tcard__sub { color: rgba(255, 255, 255, 0.7); }
  .tcard--featured .tcard__k { color: rgba(255, 255, 255, 0.6); }
  .tcard--featured .tcard__ins { color: var(--text-inverse); }
  .tcard--featured .tcard__mens { color: var(--gold-400); }
  .tcard--featured .tcard__ins span, .tcard--featured .tcard__mens span { color: rgba(255, 255, 255, 0.6); }
  /* Frais annexes par carte (uniformes, sport) */
  .tcard__extras { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border-default); display: flex; flex-direction: column; gap: 8px; }
  .tcard__row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 13px; }
  .tcard__row > span:first-child { color: var(--text-muted); }
  .tcard__row > span:last-child { color: var(--text-heading); font-weight: var(--weight-semibold); white-space: nowrap; }
  .tcard__row em { font-style: normal; font-size: 11px; color: var(--text-muted); }
  .tcard--featured .tcard__extras { border-top-color: rgba(255, 255, 255, 0.12); }
  .tcard--featured .tcard__row > span:first-child, .tcard--featured .tcard__row em { color: rgba(255, 255, 255, 0.65); }
  .tcard--featured .tcard__row > span:last-child { color: var(--text-inverse); }
  /* Pied de section : options générales + notes */
  .tarifs__foot { margin-top: var(--space-6); text-align: center; }
  .tarifs__options { list-style: none; margin: 0 0 var(--space-4); padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; }
  .tarifs__options li { font-size: 14px; color: var(--text-body); }
  .tarifs__options strong { color: var(--text-heading); }
  .tarifs__tag { display: inline-block; margin-left: 6px; font-size: 10px; font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-accent); background: var(--gold-100); border-radius: var(--radius-pill); padding: 2px 8px; }
  .tarifs__rule { font-size: var(--text-caption); color: var(--text-muted); margin: 4px 0 0; }
  .tarifs__note { text-align: center; font-size: var(--text-caption); color: var(--text-muted); font-style: italic; margin: var(--space-4) 0 0; }

  /* ---- Contact ---- */
  .contact { background: var(--brand-primary); color: var(--text-inverse); }
  .contact__grid { display: grid; grid-template-columns: 1fr 1fr; }
  .contact__map { position: relative; min-height: 360px; line-height: 0; }
  .contact__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .contact__info { padding: 56px 48px; display: flex; flex-direction: column; justify-content: center; }
  .contact__info .overline { margin: 0 0 8px; }
  .contact__info .sec-title { margin: 0 0 24px; font-size: 30px; }
  .cline { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 18px; color: var(--text-inverse); text-decoration: none; font-size: 15px; line-height: 1.5; }
  .cline :global(svg) { flex-shrink: 0; margin-top: 2px; color: var(--gold-400); }
  .cline span { opacity: 0.92; }
  a.cline:hover span { opacity: 1; text-decoration: underline; }
  .contact__cta { margin-top: 10px; }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 40px; }
    .hero__media { margin-bottom: 18px; }
    .atouts__grid { grid-template-columns: repeat(3, 1fr); gap: 28px; }
    .parcours__grid { grid-template-columns: repeat(2, 1fr); gap: 32px 10px; }
    .parcours__line { display: none; }
    .tarifs__grid { grid-template-columns: repeat(2, 1fr); }
    .contact__grid { grid-template-columns: 1fr; }
    .contact__map { min-height: 260px; }
    .fondateur__grid { grid-template-columns: 1fr; gap: 44px; }
    .fondateur__photo { height: 340px; }
  }
  @media (max-width: 620px) {
    .wrap { padding-inline: var(--space-6); }
    .hero__title { font-size: 42px; }
    .sec-title { font-size: 27px; }
    .atouts__grid { grid-template-columns: 1fr; }
    .parcours__grid { grid-template-columns: 1fr; }
    .galerie__grid { grid-template-columns: repeat(2, 1fr); }
    .galerie__cell--big { grid-column: span 2; grid-row: span 1; }
    .tarifs__grid { grid-template-columns: 1fr; }
    .calendrier__inner { padding-inline: var(--space-6); }
    .contact__info { padding: 40px var(--space-6); }
    .fondateur__quote { font-size: 18px; }
    .fondateur__badge { width: 60px; height: 60px; top: -16px; right: -8px; }
  }
</style>
